{
	"schemaVersion": 1,
	"id": "record_jukebox",
	"version": "${version}",
	"name": "Record Jukebox",
	"description": "把唱片机变成真正的音乐播放器：无视距离的立体声音乐，铁砧给唱片改名即可播放你自己放进 jukebox 文件夹的 .ogg（单曲/歌单），还支持顺序/随机/单次/定时与音量标签。",
	"authors": [
		"example"
	],
	"license": "CC0-1.0",
	"icon": "assets/record_jukebox/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.TemplateMod"
		],
		"client": [
			"com.example.TemplateModClient"
		]
	},
	"mixins": [
		"template-mod.mixins.json",
		{
			"config": "template-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": ">=1.20.1 <1.20.5",
		"java": ">=17",
		"fabric-api": "*"
	}
}
